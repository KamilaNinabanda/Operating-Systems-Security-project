#This version is supported for Debian Ubuntu and RHEL distributions

--------------------------------------------------------------------------------------
---------------------------Define path to install-------------------------------------
sudo mkdir -p /opt/oss

---------------Permissions-------------------------------------------
chmod +x install_sentinel_falco_ubuntu.sh       
sudo ./install_sentinel_falco_ubuntu.sh          # mode DRY_RUN (best option for 1st installation)

#if prefer to include directly the isolation
sudo ./install_sentinel_falco.sh --enforce

---------------TEST---------------------------------
create a mini lab to test 

   docker run -d --name victim -v /:/host alpine sleep 3600
   docker exec victim cat /host/etc/hostname
   tail -n 3 /var/lib/Sentinel_Falco/alerts.jsonl

   sudo sed -i 's/GUARD_DRY_RUN=true/GUARD_DRY_RUN=false/' /etc/falco-guard.env
   sudo systemctl restart falco-guard

   curl -H "X-Guard-Token: $TOKEN" localhost:8080/isolated_container
   curl -X POST -H "X-Guard-Token: $TOKEN" localhost:8080/release/<name>

to check the logs 
journalctl -u falco-guard -f
