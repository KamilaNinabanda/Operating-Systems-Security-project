mkdir -p ~/falco-guard-repo/service
cat > ~/falco-guard-repo/service/env.example << 'EOF'
# Copy this file to /etc/falco-guard/env and adjust the values.
# The install/setup-falco-guard.sh script automatically generates this file
# with a random token; this template is provided for reference
# or for manual installation.

# Shared token between Falco and the service. Minimum 16 characters.
# Generate it using: openssl rand -hex 24
GUARD_TOKEN=REPLACE_WITH_A_TOKEN_OF_AT_LEAST_16_CHARACTERS

# true = detect and log only; no isolation (safe mode, use this first)
# false = automatically isolate suspicious containers
DRY_RUN=true

# all   = apply isolation to any container
# label = isolate only containers with the label falco-guard.enforce=true
ENFORCE_MODE=all

# Seconds to wait before taking action on the same container again
COOLDOWN=300

# Optional: Slack webhook URL for receiving notifications
#SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Audit log directory (JSON, one entry per line)
LOG_DIR=/var/log/falco-guard
EOF
